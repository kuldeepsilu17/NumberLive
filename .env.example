# Production PostgreSQL Database Connection (Supabase / Neon / AWS RDS / Railway / Vercel Postgres)
DATABASE_URL="postgresql://postgres:[PASSWORD]@[HOST]:5432/numberlive?schema=public"

# Optional Direct URL for migrations if using a connection pooler (e.g., Supabase / Neon / PgBouncer)
# DIRECT_URL="postgresql://postgres:[PASSWORD]@[HOST]:5432/numberlive"

# Admin Authentication Secret (Generate a strong random string)
JWT_SECRET="your-secure-jwt-secret-key-change-in-production"

# Canonical Application URLs
NEXT_PUBLIC_APP_URL="https://your-domain.vercel.app"
NEXT_PUBLIC_SITE_NAME="NumberLive"
